{
  "name": "nexity-mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup:android": "powershell -ExecutionPolicy Bypass -File scripts/setup-android-sdk.ps1",
    "doctor": "react-native doctor",
    "devices": "adb devices -l",
    "reverse": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:4000 tcp:4000",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "android": "react-native run-android --port 8081 --no-packager --active-arch-only",
    "android:release": "react-native run-android --mode release --active-arch-only",
    "apk:debug": "react-native build-android --mode debug --tasks assembleDebug",
    "apk:release": "react-native build-android --mode release --tasks assembleRelease",
    "aab:release": "react-native build-android --mode release --tasks bundleRelease",
    "install:debug": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "install:release": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "uninstall": "adb uninstall com.nexity.app",
    "logcat": "react-native log-android",
    "clean:android": "react-native build-android --tasks clean",
    "clean:all": "powershell -ExecutionPolicy Bypass -File scripts/clean-all.ps1",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@react-native-camera-roll/camera-roll": "^7.10.2",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/datetimepicker": "^9.2.1",
    "@react-native-community/image-editor": "^4.3.1",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@shopify/react-native-skia": "^2.14.0",
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.20.0",
    "lucide-react-native": "^1.51.0",
    "react": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-native": "0.87.1",
    "react-native-blob-util": "^0.25.1",
    "react-native-compressor": "^1.19.4",
    "react-native-image-picker": "^8.2.1",
    "react-native-keychain": "^10.0.0",
    "react-native-nitro-image": "^0.15.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-permissions": "^5.6.2",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.28.0",
    "react-native-svg": "^15.15.5",
    "react-native-video": "^6.19.3",
    "react-native-vision-camera": "^5.2.3",
    "socket.io-client": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-dotenv": "^5.0.0",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
