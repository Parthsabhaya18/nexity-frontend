<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Nexity</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.nexity.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>nexity</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>upi</string>
		<string>tez</string>
		<string>gpay</string>
		<string>phonepe</string>
		<string>paytmmp</string>
		<string>paytm</string>
		<string>bhim</string>
		<string>credpay</string>
		<string>amazonpay</string>
		<string>mobikwik</string>
		<string>freecharge</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
	  <!-- Do not change NSAllowsArbitraryLoads to true, or you will risk app rejection! -->
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Nexity uses Bluetooth to find people nearby who also turned on Nearby. Your location is never shown.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Nexity uses Bluetooth to find people nearby who also turned on Nearby. Your location is never shown.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Nexity uses your location only for Nearby notifications you turned on. Your place is never shown to anyone.</string>
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>NearbyPrecise</key>
		<string>Nexity needs precise location for a moment so Nearby can notice people around you. Your place is never shown.</string>
	</dict>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Nexity saves photos you choose, such as a payment QR, to your photo library.</string>
	<key>NSCameraUsageDescription</key>
	<string>Nexity uses your camera so you can take photos and videos for posts, stories, reels and your profile.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Nexity uses your microphone to record sound with your videos.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Nexity lets you choose photos and videos from your library to share.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
